# Credentials for the authenticated examples and integration tests.
#
# Copy this file to `.env` and fill it in. `.env` is listed in .gitignore
# and must never be committed.
#
# 1. Create an application at https://developers.eveonline.com/applications
#    with the callback URL below and the scopes listed in ESI_SCOPES.
# 2. Fill in ESI_CLIENT_ID (and ESI_CLIENT_SECRET, unless you use the PKCE
#    flow for native/public applications).
# 3. Run `cargo run --example auth_get_refresh_token` and log in with the
#    character to test with; it writes ESI_REFRESH_TOKEN into `.env`.
# 4. Run the tests: `cargo test` (or `cargo test --test authenticated -- --nocapture`
#    to see each endpoint's result). Without these values the tests are skipped.

# Application client ID.
ESI_CLIENT_ID=
# Application secret key. Leave empty to use the PKCE (application) flow.
ESI_CLIENT_SECRET=
# Must match the callback URL registered for the application.
ESI_CALLBACK_URL=http://localhost:5000/esi/callback
# Space-separated scopes requested at login (keep the quotes).
ESI_SCOPES="esi-assets.read_assets.v1 esi-characters.read_blueprints.v1 esi-characters.read_notifications.v1 esi-clones.read_clones.v1 esi-clones.read_implants.v1 esi-industry.read_character_jobs.v1 esi-killmails.read_killmails.v1 esi-location.read_location.v1 esi-location.read_online.v1 esi-location.read_ship_type.v1 esi-mail.read_mail.v1 esi-markets.read_character_orders.v1 esi-search.search_structures.v1 esi-skills.read_skills.v1 esi-universe.read_structures.v1 esi-wallet.read_character_wallet.v1"
# Refresh token for the test character; written by the auth_get_refresh_token
# example and updated automatically when EVE SSO rotates it.
ESI_REFRESH_TOKEN=
# Contact info for the User-Agent header, as CCP asks (e.g. an email or
# "github.com/you/your-app").
ESI_USER_AGENT_CONTACT=
# Optional: a structure ID the character has docking access to, for the
# GetUniverseStructuresStructureId test. The test is skipped when empty.
ESI_TEST_STRUCTURE_ID=
